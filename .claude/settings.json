{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/ruff_fix.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(pytest *)",
      "Bash(uv run pytest *)",
      "Bash(ruff *)",
      "Bash(uv run ruff *)",
      "Bash(mypy *)",
      "Bash(uv run mypy *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs)",
      "Bash(docker compose logs *)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "Read(.env)",
      "Edit(.env)"
    ]
  }
}
